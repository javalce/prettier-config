{
  "name": "@javalce/prettier-config",
  "version": "2.2.3",
  "description": "Javier's Prettier configuration",
  "keywords": [
    "prettier"
  ],
  "homepage": "https://github.com/javalce/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/javalce/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javalce/prettier-config.git"
  },
  "license": "MIT",
  "author": "Javier Valero <javalce29@gmail.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-exports": "attw --pack .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build",
    "prepare": "husky",
    "release": "release-it",
    "release:test": "release-it --dry-run"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "dependencies": {
    "prettier-plugin-packagejson": "^3.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^24.13.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0 <4"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
